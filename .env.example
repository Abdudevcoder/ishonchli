# App database connection (Supabase Transaction pooler — port 6543)
# Supabase → Settings → Database → Transaction pooler
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres"

# Migration connection (Supabase Session pooler — port 5432, same pooler host)
# Supabase → Settings → Database → Session pooler
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# Auth.js
NEXTAUTH_SECRET="your-secret-key-min-32-chars-change-this"
NEXTAUTH_URL="https://your-project.vercel.app"

# Supabase Storage — Settings → API
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
